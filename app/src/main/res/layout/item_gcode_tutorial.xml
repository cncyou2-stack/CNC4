<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#334155"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCodeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G01"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="#0284C7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvTutorialTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="حرکت خطی برشی (Linear Cut)"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G-Code"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="دستور G01 ابزار را با نرخ پیشروی تنظیم شده (F) به صورت مستقیم به مختصات مقصد حرکت می‌دهد."
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- Example Code Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0F172A"
            android:padding="8dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مثال کد:"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvExampleCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="G01 X50 Y30 F300"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Action Button: Test in Simulator -->
        <Button
            android:id="@+id/btnTestInSimulator"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:text="تست در شبیه‌ساز ➔"
            android:textSize="12sp"
            android:backgroundTint="#0EA5E9"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
