<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121824"
    android:padding="12dp">

    <!-- Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 دستیار هوش مصنوعی Gemini CNC"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="پرسش و پاسخ تخصصی، رفع خطای کدها و تولید برنامه فرزکاری و تراشکاری"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Suggestion Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipCircle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⭕ برش دایره 20mm"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/chipSquare"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="🔲 کندهکاری مستطیل"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/chipErrorFix"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="⚠️ رفع خطای G02/G03"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <!-- Chat Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="سوال یا درخواست تولید G-Code خود را بنویسید..."
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:background="#1E293B"
            android:padding="10dp"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnSendChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:backgroundTint="#0284C7"
            android:layout_marginStart="6dp"
            android:contentDescription="ارسال" />
    </LinearLayout>

</LinearLayout>
